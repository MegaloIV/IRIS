# Plantilla de configuración de Iris. Copia a .env y rellena.
#
#   cp .env.example .env
#
# Casi todo tiene un valor por defecto razonable: lo imprescindible para
# arrancar en local son GROQ_API_KEYS y las tres de Supabase. Si Supabase falta,
# Iris cae sola a SQLite + ChromaDB y sigue funcionando, con menos memoria.

# ── LLM ───────────────────────────────────────────────────────────────────────
# Proveedores implementados: groq | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_ANALYSIS_MODEL=openai/gpt-oss-20b
# Una o varias claves separadas por comas — rotan cuando una se agota
GROQ_API_KEYS=

# ── Supabase (historial, estado, vectores, grafo, gustos, diario) ─────────────
# DATABASE_URL es la del pooler; sin ella no hay Postgres y se usa el fallback.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# ── Quién es el dueño ─────────────────────────────────────────────────────────
IRIS_OWNER_NAME=
IRIS_TIMEZONE=America/Lima
# INFO por defecto; DEBUG añade los ajustes de confianza y energía
IRIS_LOG_LEVEL=INFO

# ── Memoria ───────────────────────────────────────────────────────────────────
MEMORY_STM_WINDOW=20
MEMORY_STM_PERSIST_MESSAGES=true
MEMORY_SESSION_TIMEOUT_MINUTES=30

# ── Modo de ejecución ─────────────────────────────────────────────────────────
# local  — todo en un proceso (por defecto)
# server — el cerebro, en la VM. Sin UI, sin voz, sin escritorio.
# client — el portátil: cara, micrófono, Claude y escritorio.
IRIS_MODE=local
# Solo en modo client: dónde vive el cerebro
IRIS_SERVER_URL=https://iris.tudominio.com
# EL MISMO valor en las dos máquinas. Genéralo con:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
IRIS_AGENT_TOKEN=
IRIS_AGENT_NAME=portatil

# ── Dominio (solo en el servidor) ─────────────────────────────────────────────
# Lo usa Caddy en docker-compose para el TLS, y de aquí sale la URL con la que
# se registra el webhook de Telegram. Sin esto el bot no recibe nada.
IRIS_DOMAIN=
# Solo si la URL pública no es https://$IRIS_DOMAIN
IRIS_PUBLIC_URL=

# ── Claude Code ───────────────────────────────────────────────────────────────
CLAUDE_BIN_PATH=/home/matias/.npm-global/bin/claude
# Bash queda fuera a propósito: autorizarlo es dejar que un LLM ejecute
# cualquier comando. Si algún día hace falta, acótalo: Bash(git status *)
CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,WebSearch,WebFetch

# ── Voz ───────────────────────────────────────────────────────────────────────
STT_MODEL=medium
STT_LANGUAGE=es
STT_DEVICE=cuda
# auto | local | groq — auto usa la API de Groq en servidor y faster-whisper en local
STT_BACKEND=auto
WAKE_WORD=iris
# Claves separadas por comas (rotan). De las voces se usa la primera.
ELEVENLABS_KEYS=
ELEVENLABS_VOICE_IDS=

# ── Editor visual del cerebro ─────────────────────────────────────────────────
# Llave para abrir el grafo desde internet (/cerebro?k=...). Si se deja vacía se
# deriva de IRIS_AGENT_TOKEN. En local no se pide: quien está en la máquina
# ya está dentro.
BRAIN_TOKEN=
# En false, desde fuera solo se puede mirar; para editar, el portátil.
BRAIN_REMOTE_WRITE=true

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Tu id numérico. Sin esto, cualquiera que encuentre el bot puede hablarle.
TELEGRAM_OWNER_ID=
TELEGRAM_TTS_ENABLED=false
TELEGRAM_STT_ENABLED=false
# Telegram lo devuelve en cada update y es lo que impide que alguien fabrique
# uno diciendo ser tú. Si se deja vacío, se deriva del token del bot.
TELEGRAM_WEBHOOK_SECRET=
# Lo rellena solo el modo local con la URL del túnel. No lo toques a mano.
TELEGRAM_WEBHOOK_URL=

# ── Vida interior: el diario ──────────────────────────────────────────────────
# Cada 20–40 min Iris hace algo por su cuenta y lo anota: desarrolla una postura,
# cruza dos recuerdos, formula una pregunta, o curiosea en tus carpetas.
JOURNAL_ENABLED=true
# Empieza en false a propósito. Deja que el diario se llene, léelo con /diario
# unos días, y actívalo cuando veas que lo que escribe merece interrumpirte.
JOURNAL_SHARE_ENABLED=false
# Solo te cuenta lo que supere este umbral de ganas. Baja de 0.75 poco a poco
# hasta el punto donde te alegra que escriba en vez de molestarte.
JOURNAL_IMPULSE_THRESHOLD=0.75
JOURNAL_INTERVAL_MIN=20
JOURNAL_INTERVAL_MAX=40
# Pensar cansa: sin coste rumiaría sin parar, y por debajo del suelo descansa.
JOURNAL_ENERGY_COST=4
JOURNAL_ENERGY_FLOOR=30
# Curiosear usa Claude en el portátil, o sea cuota de la suscripción.
JOURNAL_MAX_ACTIVITIES=3

# ── Companion de escritorio (solo Windows) ────────────────────────────────────
COMPANION_ENABLED=true

# ── Carpetas a las que Iris puede acceder ─────────────────────────────────────
# Se le pasan a Claude Code como rutas disponibles para tareas de archivos.
PATH_DESKTOP=
PATH_DOCUMENTS=
PATH_DOWNLOADS=
PATH_IMAGES=
PATH_LIBRARY=
PATH_PROJECTS=
PATH_IRIS_PROJECT=
